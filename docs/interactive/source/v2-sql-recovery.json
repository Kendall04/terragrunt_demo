  "cards": [
    {
      "dot": "slate",
      "title": "Cómo leer la evidencia",
      "items": [
        "IMPLEMENTADO = código; DESPLEGADO = readback AWS fechado; DEMOSTRADO = ensayo real.",
        "Snapshot DEV: 6 nov 2026. No certifica PROD ni disponibilidad continua.",
        "Gris: datos/control; violeta: eventos; rosa: seguridad. Respuestas implícitas."
      ]
    },
    {
      "dot": "slate",
      "title": "RTO observado, desde drain hasta API",
      "items": [
        "CROSS-AZ A → B: 41m31.5s, incluye fallos reconciliados y reparaciones.",
        "SAME-AZ B → B: 24m42.6s, incluye reboot; camino corregido sin replay.",
        "La copia destino se crea desde cero. No hay segunda base activa permanente."
      ]
    },
    {
      "dot": "slate",
      "title": "Backup, retención y RPO",
      "items": [
        "Objetivo RPO: 1 h + duración de backup/subida; freshness: 2 h. No PITR.",
        "Lifecycle instalado: elegibles 7 d, versiones no actuales +1 d; últimos dos pares sin tag.",
        "Prefijos históricos / holds excluidos. Expiración por objeto asíncrona, no transacción por pareja.",
        "Pin fuera TTL exigido por retención; copia automatizada y ensayo con Lifecycle NO VALIDADOS."
      ]
    },
    {
      "dot": "amber",
      "title": "Activación con condiciones",
      "items": [
        "Un origen inaccesible no es un fence. Se comprueba identidad EC2 terminada antes de activar.",
        "Backup final tras fence SQL evita pérdida planificada: NO demuestra RPO cero abrupto.",
        "Discos previos no son rollback automático; escritura posterior exige reconciliar datos."
      ]
    }
  ]
