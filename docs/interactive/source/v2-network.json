  "cards": [
    {
      "dot": "slate",
      "title": "Cómo leer la evidencia",
      "items": [
        "IMPLEMENTADO = código; DESPLEGADO = readback AWS fechado; DEMOSTRADO = ensayo real.",
        "Snapshot DEV: 6 nov 2026. No certifica PROD ni disponibilidad continua.",
        "Gris: datos/control; violeta: eventos; rosa: seguridad. Respuestas implícitas."
      ]
    },
    {
      "dot": "slate",
      "title": "Región us-east-1 · VPC 10.0.0.0/16",
      "items": [
        "Columnas A/B = us-east-1a / us-east-1b; marcos agrupan una AZ, no un único SG.",
        "ALB y VPC Link usan ambas subnets privadas; el plano de entrada figura en v2-platform.",
        "Sin VPC endpoints en el readback. SQL/blue están en B después de la recuperación."
      ]
    },
    {
      "dot": "amber",
      "title": "Dos NAT Instances, no NAT Gateways",
      "items": [
        "LT A:4 / B:4; SDC=false; forwarding/MASQUERADE en cada host.",
        "ASG repone EC2; evento Launch Successful invoca tres Lambda :6 para EIP, ruta y SDC.",
        "Sin failover cruzado automático. Sentinel observa A; no repara ni observa HTTPS B continuamente."
      ]
    }
  ],
