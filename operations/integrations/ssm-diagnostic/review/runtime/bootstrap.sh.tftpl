#!/bin/bash
set -euo pipefail
umask 077
/usr/bin/python3 -I -B - <<'PY'
import base64,hashlib,json,os,pathlib,subprocess
binding=json.loads(base64.b64decode('${binding_base64}',validate=True))
base=pathlib.Path('/opt/terragrunt-demo/ssm-diagnostic')
base.mkdir(parents=True,mode=0o700,exist_ok=False)
files={'collector.py': '', 'harness.py': '', 'observer_host.py': ''}
for name,data in files.items():
    raw=base64.b64decode(data,validate=True)
    with (base/name).open('xb') as f:f.write(raw)
    os.chmod(base/name,0o600)
cfg={'run': 'ecs-sentinel-ssmdiag-r20261024d1', 'account': '341936017254', 'region': 'us-east-1', 'expires_at': None, 'log_group': '/ecs/ssm-diagnostic/ecs-sentinel-ssmdiag-r20261024d1', 'role': 'ecs-sentinel-ssmdiag-r20261024d1-node', 'source_sha256': '772c35dfed78d4f1e598d39a2c8a3f6c9d3e103182b8943e57eae1c24f79cbf5'}
host={'account': '341936017254', 'region': 'us-east-1', 'run_id': 'ecs-sentinel-ssmdiag-r20261024d1', 'subject': 'diagnostic-only', 'bucket': 'diagnostic-no-bucket', 'prefix': 'unused/original', 'missing_prefix': 'sentinel-observer/ecs-sentinel-ssmdiag-r20261024d1/unused', 'backup_key_arn': 'arn:aws:kms:us-east-1:341936017254:key/00000000-0000-0000-0000-000000000001', 'text_key_arn': 'arn:aws:kms:us-east-1:341936017254:key/00000000-0000-0000-0000-000000000002', 'database': 'diagnostic_only', 'max_age_hours': 1, 'expires_at': None, 'cadence_seconds': 60, 'publish_attempts': 1, 'aws_cli': '/usr/bin/aws', 'uid': 0}
cfg['expires_at']=host['expires_at']=binding['expires_at']
hc={'observerSha256': '0f04fc48e7116218fcfa511fb4498a7fe3473de5dc69cd7b330b7772e13f94fd'}
for name,value in [('collector-config.json',cfg),('host.json',host),('harness-config.json',hc)]:
    with (base/name).open('x',encoding='utf-8') as f:json.dump(value,f)
    os.chmod(base/name,0o600)
(base/'state').mkdir(mode=0o700)
(base/'state/mode.json').write_text('{"mode":"missing"}',encoding='utf-8')
for executable in ['/usr/bin/aws','/usr/bin/amazon-ssm-agent','/usr/bin/systemctl','/usr/bin/python3','/usr/bin/systemd-run']:
    if not os.path.isfile(executable):raise SystemExit('AMI_TOOL_MISSING_NO_INSTALL')
env={'PATH':'/usr/bin:/bin','LANG':'C.UTF-8'}
# No status invocation at boot. New command evidence must come from the owned document.
r=subprocess.run(['/usr/bin/systemd-run','--unit=ecs-ssmdiag-collector','--property=RuntimeMaxSec=7500','--property=UMask=0077','--property=SendSIGKILL=no','/usr/bin/python3','-I','-B',str(base/'collector.py'),'--execute'],env=env)
if r.returncode:raise SystemExit('COLLECTOR_START_UNCONFIRMED')
PY
