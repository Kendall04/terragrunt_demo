{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateSubnet",
        "ec2:CreateSecurityGroup",
        "ec2:CreateInternetGateway",
        "ec2:CreateRouteTable"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:341936017254:vpc/*",
        "arn:aws:ec2:us-east-1:341936017254:subnet/*",
        "arn:aws:ec2:us-east-1:341936017254:security-group/*",
        "arn:aws:ec2:us-east-1:341936017254:internet-gateway/*",
        "arn:aws:ec2:us-east-1:341936017254:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:RequestTag/Trial": "ecs-sentinel-ssmdiag-r20261024d1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateSecurityGroup",
        "ec2:CreateRouteTable"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:341936017254:vpc/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:ResourceTag/Trial": "ecs-sentinel-ssmdiag-r20261024d1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyVpcAttribute",
        "ec2:DeleteVpc",
        "ec2:ModifySubnetAttribute",
        "ec2:DeleteSubnet",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:DeleteInternetGateway",
        "ec2:DeleteRouteTable",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:ReplaceRoute",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:TerminateInstances",
        "ec2:ModifyInstanceCreditSpecification"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:341936017254:vpc/*",
        "arn:aws:ec2:us-east-1:341936017254:subnet/*",
        "arn:aws:ec2:us-east-1:341936017254:internet-gateway/*",
        "arn:aws:ec2:us-east-1:341936017254:route-table/*",
        "arn:aws:ec2:us-east-1:341936017254:security-group/*",
        "arn:aws:ec2:us-east-1:341936017254:instance/*",
        "arn:aws:ec2:us-east-1:341936017254:volume/*",
        "arn:aws:ec2:us-east-1:341936017254:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:ResourceTag/Trial": "ecs-sentinel-ssmdiag-r20261024d1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:341936017254:vpc/*",
        "arn:aws:ec2:us-east-1:341936017254:subnet/*",
        "arn:aws:ec2:us-east-1:341936017254:internet-gateway/*",
        "arn:aws:ec2:us-east-1:341936017254:route-table/*",
        "arn:aws:ec2:us-east-1:341936017254:security-group/*",
        "arn:aws:ec2:us-east-1:341936017254:instance/*",
        "arn:aws:ec2:us-east-1:341936017254:volume/*",
        "arn:aws:ec2:us-east-1:341936017254:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:RequestTag/Trial": "ecs-sentinel-ssmdiag-r20261024d1",
          "ec2:CreateAction": [
            "CreateVpc",
            "CreateSubnet",
            "CreateSecurityGroup",
            "CreateInternetGateway",
            "CreateRouteTable",
            "RunInstances"
          ]
        },
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1::image/ami-0d6e34c14757a048b",
        "arn:aws:ec2:us-east-1:341936017254:volume/*",
        "arn:aws:ec2:us-east-1:341936017254:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:341936017254:subnet/*",
        "arn:aws:ec2:us-east-1:341936017254:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:ResourceTag/Trial": "ecs-sentinel-ssmdiag-r20261024d1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:341936017254:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:RequestTag/Trial": "ecs-sentinel-ssmdiag-r20261024d1",
          "ec2:InstanceType": "t3.micro",
          "ec2:MetadataHttpTokens": "required"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        },
        "ArnEquals": {
          "ec2:InstanceProfile": "arn:aws:iam::341936017254:instance-profile/ecs-sentinel-ssmdiag-r20261024d1-node"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::341936017254:role/ecs-sentinel-ssmdiag-r20261024d1-node"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        },
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": [
        "arn:aws:iam::341936017254:role/ecs-sentinel-ssmdiag-r20261024d1-node"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:GetInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::341936017254:instance-profile/ecs-sentinel-ssmdiag-r20261024d1-node"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeVpcAttribute",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeRouteTables",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstanceAttribute",
        "ec2:DescribeInstanceCreditSpecifications",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeVolumes",
        "ec2:DescribeImages",
        "ec2:DescribeTags",
        "ec2:DescribeAccountAttributes",
        "ec2:DescribeAvailabilityZones",
        "ssm:GetCommandInvocation",
        "ssm:ListCommands",
        "ssm:ListCommandInvocations",
        "ssm:DescribeInstanceInformation",
        "logs:DescribeLogGroups",
        "cloudtrail:LookupEvents"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssm:CreateDocument",
        "ssm:GetDocument",
        "ssm:DescribeDocument",
        "ssm:DescribeDocumentPermission",
        "ssm:ListDocumentVersions",
        "ssm:DeleteDocument",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource",
        "ssm:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:341936017254:document/ecs-sentinel-ssmdiag-r20261024d1-observer-control"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:341936017254:document/ecs-sentinel-ssmdiag-r20261024d1-observer-control"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        },
        "Bool": {
          "aws:ViaAWSService": "false"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:341936017254:instance/__VERIFIED_INSTANCE_ID__"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ssm:resourceTag/Trial": "ecs-sentinel-ssmdiag-r20261024d1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        },
        "Bool": {
          "aws:ViaAWSService": "false"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:341936017254:document/ecs-sentinel-ssmdiag-r20261024d1-observer-control"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        },
        "Bool": {
          "aws:ViaAWSService": "true"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:341936017254:instance/__VERIFIED_INSTANCE_ID__"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        },
        "Bool": {
          "aws:ViaAWSService": "true"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:GetConsoleOutput"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:341936017254:instance/__VERIFIED_INSTANCE_ID__"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:DeleteLogGroup",
        "logs:ListTagsForResource",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:341936017254:log-group:/ecs/ssm-diagnostic/ecs-sentinel-ssmdiag-r20261024d1",
        "arn:aws:logs:us-east-1:341936017254:log-group:/ecs/ssm-diagnostic/ecs-sentinel-ssmdiag-r20261024d1:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1/ssm-diagnostic/ecs-sentinel-ssmdiag-r20261024d1/runtime/terraform.tfstate",
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1/ssm-diagnostic/ecs-sentinel-ssmdiag-r20261024d1/runtime/terraform.tfstate.tflock"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1/ssm-diagnostic/ecs-sentinel-ssmdiag-r20261024d1/runtime/terraform.tfstate.tflock"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        },
        "StringLike": {
          "s3:prefix": [
            "ssm-diagnostic/ecs-sentinel-ssmdiag-r20261024d1/runtime/terraform.tfstate*",
            "ssm-diagnostic/ecs-sentinel-ssmdiag-r20261024d1/runtime/workspaces/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey"
      ],
      "Resource": [
        "arn:aws:kms:us-east-1:341936017254:key/585f0833-6a1c-465d-ab40-a6c8278cae39"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        }
      }
    }
  ]
}
