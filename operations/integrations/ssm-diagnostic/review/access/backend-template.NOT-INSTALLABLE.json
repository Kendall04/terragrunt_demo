{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TLSOnly",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1",
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "OnlyOwnEnvironmentAndAdmin",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1",
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1/*"
      ],
      "Condition": {
        "ArnNotEquals": {
          "aws:PrincipalArn": [
            "arn:aws:iam::341936017254:user/cnp-cert-admin",
            "arn:aws:iam::341936017254:role/e1-request-plan-dev",
            "arn:aws:iam::341936017254:role/e1-request-infra-dev",
            "arn:aws:iam::341936017254:role/e1-request-infra-high-risk-dev",
            "arn:aws:iam::341936017254:role/e1-gateway-infra-dev-exec",
            "arn:aws:iam::341936017254:role/e1-gateway-infra-high-risk-dev-exec",
            "arn:aws:iam::341936017254:role/e1-controller-infra-dev-exec",
            "arn:aws:iam::341936017254:role/e1-controller-infra-high-risk-dev-exec",
            "arn:aws:iam::341936017254:role/TerragruntDemoDevOperator"
          ]
        }
      }
    },
    {
      "Sid": "ExternalNoWrite",
      "Effect": "Deny",
      "Principal": "*",
      "NotAction": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1",
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1/*"
      ],
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::341936017254:role/e1-request-*"
        }
      }
    },
    {
      "Sid": "ExternalOnlyOwnPublic",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:GetObject",
      "NotResource": [
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1/operations/environment-lifecycle/infra-dev/*/public.json",
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1/operations/environment-lifecycle/infra-high-risk-dev/*/public.json"
