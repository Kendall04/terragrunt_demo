      },
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        },
        "StringLike": {
          "s3:prefix": [
            "ssm-diagnostic/ecs-sentinel-ssmdiag-r20261024d1/runtime/terraform.tfstate*",
            "ssm-diagnostic/ecs-sentinel-ssmdiag-r20261024d1/runtime/workspaces/*"
          ]
        }
