      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": [
            "arn:aws:iam::341936017254:role/e1-request-infra-dev",
            "arn:aws:iam::341936017254:role/e1-request-infra-high-risk-dev"
          ]
        }
      }
    },
    {
      "Sid": "PlanOnlyOwnState",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:GetObject",
      "NotResource": [
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1/e1/lifecycle/dev/shared/terraform.tfstate",
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1/e1/lifecycle/dev/secrets/terraform.tfstate",
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1/e1/lifecycle/dev/global/terraform.tfstate",
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1/e1/lifecycle/dev/data/terraform.tfstate",
