        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1/*"
      ],
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::341936017254:role/TerragruntDemoDevOperator"
        }
      }
