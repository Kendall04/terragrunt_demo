    {
      "Sid": "DiagStateReadWrite",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::341936017254:role/TerragruntDemoDevOperator"
      },
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1/ssm-diagnostic/ecs-sentinel-ssmdiag-r20261024d1/runtime/terraform.tfstate",
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1/ssm-diagnostic/ecs-sentinel-ssmdiag-r20261024d1/runtime/terraform.tfstate.tflock"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${var.expires_at}"
        }
      }
    },
    {
      "Sid": "DiagLockDelete",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::341936017254:role/TerragruntDemoDevOperator"
      },
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::e1-lifecycle-dev-341936017254-us-east-1/ssm-diagnostic/ecs-sentinel-ssmdiag-r20261024d1/runtime/terraform.tfstate.tflock"
