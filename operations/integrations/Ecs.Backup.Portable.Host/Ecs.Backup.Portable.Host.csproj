<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors><GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles><CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile></PropertyGroup>
 <ItemGroup><ProjectReference Include="$(PortableSentinelSourceRoot)/src/Sentinel.Portable.Lambda/Sentinel.Portable.Lambda.csproj" /><Compile Include="../Ecs.Backup.Portable.Notice/ReadableNotice.cs" Link="ReadableNotice.cs" /></ItemGroup>
 <Target Name="RequireReviewedRuntimeSource" BeforeTargets="PrepareForBuild"><Error Condition="!Exists('$(PortableSentinelSourceRoot)/ecs-portable-runtime-receipt.json')" Text="Prepare exact pinned runtime source and explicit formatter extensions." /></Target>
 <Target Name="ExcludeTransitiveSymbols" AfterTargets="ComputeFilesToPublish"><ItemGroup><ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" /></ItemGroup></Target>
</Project>
