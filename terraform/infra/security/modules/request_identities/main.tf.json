{
  "terraform": {
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 5.50"
      }
    }
  },
  "variable": {
    "authority": {
      "type": "any",
      "description": "Only the closed security-root authority source may call this module."
    },
    "account_id": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "endpoints": {
      "type": "map(string)"
    },
    "dev_cicd_installation_only": {
      "type": "bool",
      "default": false
    }
  },
  "resource": {
    "aws_iam_role": {
      "request": {
        "for_each": "${{for key,v in var.authority.request_identities:key=>v if !var.dev_cicd_installation_only || contains([\"release\",\"deploy-dev\"],key)}}",
        "name": "${each.value.name}",
        "assume_role_policy": "${contains(keys(local.wp6_active),each.key) ? jsonencode(local.wp6_trusts[each.key]) : jsonencode(var.authority.policies.inert_trust)}",
        "description": "Protected WP6 request reservation; inactive until exact approval/installation/governance gates.",
        "tags": {
          "E1Owner": "${each.value.owner}",
          "E1Stage": "${each.value.stage}"
        }
      }
    },
    "aws_iam_role_policy": {
      "inert": {
        "for_each": "${{for key,v in var.authority.request_identities:key=>v if !contains(keys(local.wp6_active),key) && (!var.dev_cicd_installation_only || contains([\"release\",\"deploy-dev\"],key))}}",
        "name": "wp2a-inert",
        "role": "${aws_iam_role.request[each.key].id}",
        "policy": "${jsonencode(var.authority.policies.inert_permissions)}"
      },
      "wp6": {
        "for_each": "${local.wp6_active}",
        "name": "wp6-request-only",
        "role": "${aws_iam_role.request[each.key].id}",
        "policy": "${jsonencode(local.wp6_policies[each.key])}",
        "lifecycle": {
          "precondition": {
            "condition": "${length(jsonencode(local.wp6_policies[each.key]))<=10240}",
            "error_message": "Exact read/request inventory exceeds the IAM inline ceiling; keep this identity inactive."
          }
        }
      }
    }
  },
  "output": {
    "role_arns": {
      "value": "${{ for key, role in aws_iam_role.request : key => role.arn }}"
    },
    "wp6": {
      "value": "${{active=keys(local.wp6_active),reserved=keys(var.authority.request_identities),live=\"UNVERIFIED\"}}"
    }
  },
  "locals": {
    "wp6_records": "${var.authority.wp6.approvals}",
    "wp6_selected": "${var.authority.wp6.selected}",
    "wp6_admitted": {},
    "wp6_active": "${{for key,v in local.wp6_records:key=>v if try(contains(keys(local.wp6_selected),key) && v==local.wp6_admitted[key] && v.identity==key && v.environment==local.wp6_selected[key].environment && v.account==var.account_id && v.region==var.region && v.active==true && v.governance==\"ADMIN_VERIFIED_G1_G9\" && can(regex(\"^[0-9a-f]{40}$\",v.workflow_commit)) && v.workflow_commit!=\"0000000000000000000000000000000000000000\" && v.source_sha256==var.authority.wp6.source_sha256 && length(keys(v))==11 && (startswith(key,\"plan-\") ? (v.gateway_version==null && v.endpoint_readback==\"ADMIN_VERIFIED_PLAN_READ_ONLY\" && v.plan_binding.source_commit==v.workflow_commit && v.plan_binding.readback==\"ADMIN_VERIFIED_NONSECRET_STATE_AND_EXACT_BINDINGS\") : (v.plan_binding==null && can(regex(\"^[1-9][0-9]*$\",v.gateway_version)) && v.endpoint_readback==try(var.endpoints[\"request-gateway/${key}\"],null) && v.endpoint_readback==\"arn:aws:lambda:${var.region}:${var.account_id}:function:${local.wp6_selected[key].gateway}:${v.gateway_version}\")),false)}}",
    "wp6_trust_templates": {
      "plan-dev": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Federated\":\"arn:aws:iam::WP6_ACCOUNT:oidc-provider/token.actions.githubusercontent.com\"},\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Condition\":{\"StringEquals\":{\"token.actions.githubusercontent.com:aud\":\"sts.amazonaws.com\",\"token.actions.githubusercontent.com:sub\":\"repo:Kendall04/terragrunt_demo:environment:e1-plan-dev:job_workflow_ref:Kendall04/terragrunt_demo/.github/workflows/e1-plan-dev.yml@WP6_COMMIT\"}}}]}",
      "plan-prod": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Federated\":\"arn:aws:iam::WP6_ACCOUNT:oidc-provider/token.actions.githubusercontent.com\"},\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Condition\":{\"StringEquals\":{\"token.actions.githubusercontent.com:aud\":\"sts.amazonaws.com\",\"token.actions.githubusercontent.com:sub\":\"repo:Kendall04/terragrunt_demo:environment:e1-plan-prod:job_workflow_ref:Kendall04/terragrunt_demo/.github/workflows/e1-plan-prod.yml@WP6_COMMIT\"}}}]}",
      "infra-dev": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Federated\":\"arn:aws:iam::WP6_ACCOUNT:oidc-provider/token.actions.githubusercontent.com\"},\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Condition\":{\"StringEquals\":{\"token.actions.githubusercontent.com:aud\":\"sts.amazonaws.com\",\"token.actions.githubusercontent.com:sub\":\"repo:Kendall04/terragrunt_demo:environment:e1-infra-dev:job_workflow_ref:Kendall04/terragrunt_demo/.github/workflows/e1-infra-dev.yml@WP6_COMMIT\"}}}]}",
      "infra-prod": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Federated\":\"arn:aws:iam::WP6_ACCOUNT:oidc-provider/token.actions.githubusercontent.com\"},\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Condition\":{\"StringEquals\":{\"token.actions.githubusercontent.com:aud\":\"sts.amazonaws.com\",\"token.actions.githubusercontent.com:sub\":\"repo:Kendall04/terragrunt_demo:environment:e1-infra-prod:job_workflow_ref:Kendall04/terragrunt_demo/.github/workflows/e1-infra-prod.yml@WP6_COMMIT\"}}}]}",
      "infra-high-risk-dev": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Federated\":\"arn:aws:iam::WP6_ACCOUNT:oidc-provider/token.actions.githubusercontent.com\"},\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Condition\":{\"StringEquals\":{\"token.actions.githubusercontent.com:aud\":\"sts.amazonaws.com\",\"token.actions.githubusercontent.com:sub\":\"repo:Kendall04/terragrunt_demo:environment:e1-infra-high-risk-dev:job_workflow_ref:Kendall04/terragrunt_demo/.github/workflows/e1-infra-high-risk-dev.yml@WP6_COMMIT\"}}}]}",
      "infra-high-risk-prod": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Federated\":\"arn:aws:iam::WP6_ACCOUNT:oidc-provider/token.actions.githubusercontent.com\"},\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Condition\":{\"StringEquals\":{\"token.actions.githubusercontent.com:aud\":\"sts.amazonaws.com\",\"token.actions.githubusercontent.com:sub\":\"repo:Kendall04/terragrunt_demo:environment:e1-infra-high-risk-prod:job_workflow_ref:Kendall04/terragrunt_demo/.github/workflows/e1-infra-high-risk-prod.yml@WP6_COMMIT\"}}}]}",
      "release": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Federated\":\"arn:aws:iam::WP6_ACCOUNT:oidc-provider/token.actions.githubusercontent.com\"},\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Condition\":{\"StringEquals\":{\"token.actions.githubusercontent.com:aud\":\"sts.amazonaws.com\",\"token.actions.githubusercontent.com:sub\":\"repo:Kendall04/terragrunt_demo:environment:e1-release:job_workflow_ref:Kendall04/terragrunt_demo/.github/workflows/e1-release.yml@WP6_COMMIT\"}}}]}",
      "deploy-dev": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Federated\":\"arn:aws:iam::WP6_ACCOUNT:oidc-provider/token.actions.githubusercontent.com\"},\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Condition\":{\"StringEquals\":{\"token.actions.githubusercontent.com:aud\":\"sts.amazonaws.com\",\"token.actions.githubusercontent.com:sub\":\"repo:Kendall04/terragrunt_demo:environment:e1-dev-deploy:job_workflow_ref:Kendall04/terragrunt_demo/.github/workflows/e1-dev-deploy.yml@WP6_COMMIT\"}}}]}",
      "promote-prod": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Federated\":\"arn:aws:iam::WP6_ACCOUNT:oidc-provider/token.actions.githubusercontent.com\"},\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Condition\":{\"StringEquals\":{\"token.actions.githubusercontent.com:aud\":\"sts.amazonaws.com\",\"token.actions.githubusercontent.com:sub\":\"repo:Kendall04/terragrunt_demo:environment:e1-prod-promote:job_workflow_ref:Kendall04/terragrunt_demo/.github/workflows/e1-prod-promote.yml@WP6_COMMIT\"}}}]}",
      "emergency-dev": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Federated\":\"arn:aws:iam::WP6_ACCOUNT:oidc-provider/token.actions.githubusercontent.com\"},\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Condition\":{\"StringEquals\":{\"token.actions.githubusercontent.com:aud\":\"sts.amazonaws.com\",\"token.actions.githubusercontent.com:sub\":\"repo:Kendall04/terragrunt_demo:environment:e1-dev-emergency:job_workflow_ref:Kendall04/terragrunt_demo/.github/workflows/e1-dev-emergency.yml@WP6_COMMIT\"}}}]}",
      "emergency-prod": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Federated\":\"arn:aws:iam::WP6_ACCOUNT:oidc-provider/token.actions.githubusercontent.com\"},\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Condition\":{\"StringEquals\":{\"token.actions.githubusercontent.com:aud\":\"sts.amazonaws.com\",\"token.actions.githubusercontent.com:sub\":\"repo:Kendall04/terragrunt_demo:environment:e1-prod-emergency:job_workflow_ref:Kendall04/terragrunt_demo/.github/workflows/e1-prod-emergency.yml@WP6_COMMIT\"}}}]}"
    },
    "wp6_policy_templates": {
      "plan-dev": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"ec2:DescribeAvailabilityZones\",\"ec2:DescribeVpcs\",\"ec2:DescribeVpcAttribute\",\"ec2:DescribeSubnets\",\"ec2:DescribeSecurityGroups\",\"ec2:DescribeSecurityGroupRules\",\"ec2:DescribeRouteTables\",\"ec2:DescribeInternetGateways\",\"ec2:DescribeAddresses\",\"ec2:DescribeFlowLogs\",\"ec2:DescribeInstances\",\"ec2:DescribeInstanceAttribute\",\"ec2:DescribeVolumes\",\"ec2:DescribeVolumesModifications\",\"ec2:DescribeLaunchTemplateVersions\",\"ec2:DescribeImages\",\"ec2:DescribeTags\"],\"Resource\":[\"*\"],\"Condition\":{\"StringEquals\":{\"aws:RequestedRegion\":\"WP6_REGION\"}}},{\"Effect\":\"Allow\",\"Action\":[\"elasticloadbalancing:DescribeLoadBalancers\",\"elasticloadbalancing:DescribeLoadBalancerAttributes\",\"elasticloadbalancing:DescribeListeners\",\"elasticloadbalancing:DescribeRules\",\"elasticloadbalancing:DescribeTargetGroups\",\"elasticloadbalancing:DescribeTargetGroupAttributes\",\"elasticloadbalancing:DescribeTags\"],\"Resource\":[\"*\"],\"Condition\":{\"StringEquals\":{\"aws:RequestedRegion\":\"WP6_REGION\"}}},{\"Effect\":\"Allow\",\"Action\":[\"autoscaling:DescribeAutoScalingGroups\",\"autoscaling:DescribeScalingActivities\",\"autoscaling:DescribeTags\"],\"Resource\":[\"*\"],\"Condition\":{\"StringEquals\":{\"aws:RequestedRegion\":\"WP6_REGION\"}}},{\"Effect\":\"Allow\",\"Action\":[\"logs:DescribeLogGroups\"],\"Resource\":[\"*\"],\"Condition\":{\"StringEquals\":{\"aws:RequestedRegion\":\"WP6_REGION\"}}},{\"Effect\":\"Allow\",\"Action\":[\"ecs:ListAccountSettings\"],\"Resource\":[\"*\"],\"Condition\":{\"StringEquals\":{\"aws:RequestedRegion\":\"WP6_REGION\"}}},{\"Effect\":\"Allow\",\"Action\":[\"ecs:DescribeClusters\",\"ecs:ListTagsForResource\"],\"Resource\":[\"WP6_cluster\"]},{\"Effect\":\"Allow\",\"Action\":[\"ecs:DescribeServices\",\"ecs:ListTagsForResource\"],\"Resource\":[\"WP6_services\"]},{\"Effect\":\"Allow\",\"Action\":[\"ecs:DescribeTaskDefiniti