        "StringEquals": {
          "ec2:CreateAction": [
            "CreateSubnet"
          ],
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Project": "demo",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:341936017254:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Project": "demo",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:341936017254:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "CreateSecurityGroup"
          ],
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Project": "demo",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateInternetGateway"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:341936017254:internet-gateway/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Project": "demo",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:341936017254:internet-gateway/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "CreateInternetGateway"
          ],
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Project": "demo",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateRouteTable"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:341936017254:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Project": "demo",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:341936017254:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "CreateRouteTable"
          ],
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Project": "demo",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:AllocateAddress"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:341936017254:elastic-ip/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Project": "demo",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:341936017254:elastic-ip/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "AllocateAddress"
          ],
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Project": "demo",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:CreateLoadBalancer"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:us-east-1:341936017254:loadbalancer/app/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Project": "demo",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:AddTags"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:us-east-1:341936017254:loadbalancer/app/demo-dev-*"
      ],
      "Condition": {
        "StringEquals": {
          "elasticloadbalancing:CreateAction": [
            "CreateLoadBalancer"
          ],
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:CreateTargetGroup"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:us-east-1:341936017254:targetgroup/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Project": "demo",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:AddTags"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:us-east-1:341936017254:targetgroup/demo-dev-*"
